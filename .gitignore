# Binaries for programs and plugins
*.exe
*.exe~
*.dll
*.so
*.dylib
flag_tool
db
# Test binary, built with `go test -c`
*.test

# Code coverage profiles and other test artifacts
*.out
coverage.*
*.coverprofile
profile.cov

# Dependency directories (remove the comment below to include it)
# vendor/

__pycache__/

# Go workspace file
go.work
go.work.sum

# env file
.env

# Vagrant ignores
.vagrant

# Opentofu 
terraform.tfvars

# Editor/IDE
# .idea/
.vscode/

# MacOS specific files
.DS_Store

# Database
*.db

